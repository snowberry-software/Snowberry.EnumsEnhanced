<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <LangVersion>latest</LangVersion>

        <IsPackable>false</IsPackable>
        <IsPublishable>false</IsPublishable>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="xunit.v3" />
        <PackageReference Include="coverlet.MTP" />
        <PackageReference Include="AwesomeAssertions" />
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    </ItemGroup>

    <ItemGroup>
        <!-- Reference the generator as a normal library so the generator type is available to
             drive manually via CSharpGeneratorDriver (NOT as an analyzer applied to this project). -->
        <ProjectReference Include="..\..\Snowberry.EnumsEnhanced\Snowberry.EnumsEnhanced.csproj" />
    </ItemGroup>

    <ItemGroup>
        <!-- Approved generator snapshots are data, not code: keep them out of the compilation. -->
        <Compile Remove="Snapshots\**" />
        <None Include="Snapshots\**" />
    </ItemGroup>

    <ItemGroup>
        <Using Include="Xunit" />
        <Using Include="AwesomeAssertions" />
    </ItemGroup>

</Project>
